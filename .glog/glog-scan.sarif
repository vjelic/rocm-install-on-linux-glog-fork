                      "deletedRegion": {
                        "charOffset": 31401,
                        "charLength": 28
                      },
                      "insertedContent": {
                        "text": "strcat_s(query,  1,  (char*)&c)"
                      }
                    }
                  ]
                }
              ]
            },
